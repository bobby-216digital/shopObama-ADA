
{% render 'button', link: block.settings.link %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "Button — Filled"
        },
        {
          "value": "button-secondary",
          "label": "Button — Outline"
        },
        {
          "value": "button-nav",
          "label": "Button — Nav (outline, overlay use)"
        },
        {
          "value": "button-transparent",
          "label": "Button — Transparent"
        },
        {
          "value": "button-transparent-white",
          "label": "Button — Transparent White"
        },
        {
          "value": "link",
          "label": "Link — Large"
        },
        {
          "value": "link-small",
          "label": "Link — Small"
        },
        {
          "value": "link-inline",
          "label": "Link — Inline"
        }
      ],
      "default": "button"
    },
    {
      "type": "select",
      "id": "arrow_style",
      "label": "Arrow icon",
      "options": [
        { "value": "default", "label": "Default (→ on Link styles, none on buttons)" },
        { "value": "none", "label": "None" },
        { "value": "right", "label": "Right →" },
        { "value": "external", "label": "External ↗" },
        { "value": "down", "label": "Down ↓" },
        { "value": "up", "label": "Up ↑" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Custom colors (optional)"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to use the section's theme colors."
    },
    {
      "type": "color",
      "id": "custom_color",
      "label": "Default text color",
      "alpha": false
    },
    {
      "type": "color",
      "id": "custom_hover_color",
      "label": "Hover text color",
      "alpha": false
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
